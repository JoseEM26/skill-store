# Database connection URL (PostgreSQL)
# Local Docker Postgres runs on port 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/skill_store?schema=public"

# GitHub OAuth App Credentials
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Auth.js / NextAuth Secret
# Generate with `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="your-32-character-secret-key-here"

# Session Max Age in seconds (optional, default: 2592000 = 30 days)
AUTH_SESSION_MAX_AGE="2592000"
